package randomnumberprogrammingproject;

import java.util.Random;
import java.util.Scanner;

/**
 *
 * @author gnorris2027
 */
public class RandomNumberProgrammingProject {

    /**
     * @param args the command line arguments
     */
    public static void main(String[] args) {
        Scanner scan = new Scanner(System.in);
        Random generator = new Random();
        String input = "";

        while (!input.equals("-1")) {
            System.out.print("Press 'p' for phone number, 'r' for die roll (enter -1 to stop): ");
            input = scan.next();
            // Part 1: Phone Number Generator
            if (input.equalsIgnoreCase("p")) {
                int d1 = generator.nextInt(8);
                int d2 = generator.nextInt(8);
                int d3 = generator.nextInt(8);
                int middle = generator.nextInt(656);
                int last = generator.nextInt(10000);

                System.out.printf("%d%d%d-%03d-%04d%n", d1, d2, d3, middle, last);
            // Part 2: 6 Sided Die Generator
            } else if (input.equalsIgnoreCase("r")) {
                int roll = generator.nextInt(6) + 1;
                System.out.println("Rolled: " + roll);
            }
        }

        scan.close();
    }
}
