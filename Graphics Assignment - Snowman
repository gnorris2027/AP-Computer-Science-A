package displaygraph;

import java.awt.*;
import javax.swing.*;

/**
 *
 * @author gnorris2027
 */
public class DisplayGraph extends JPanel {

    // this is a constructor method.
    public DisplayGraph() {
        super();
    }

    /* Create a paintComponent() method to override the one in
       JPanel. This is where the drawing happens. We don't have
       to call it in our program, it gets called automatically
       whenever the panel needs to be redrawn, like when it is
       made visible or moved or whatever.
    */
    public void paintComponent(Graphics g) {
        final int MID = 160;
        final int TOP = 60;

        g.setColor(new Color(25, 25, 112)); // set the graphics object's paint color
        g.fillRect(0, 0, 400, 300); // background
        g.setColor(Color.WHITE); // resetting paint color
        g.fillRoundRect(0, 180, 400, 120, 20, 20); // ground
        g.fillOval(MID - 20, TOP, 40, 40);   // head
        g.fillOval(MID - 35, TOP + 35, 70, 50); // upper torso
        g.fillOval(MID - 50, TOP + 80, 100, 60); // lower torso
        g.setColor(Color.RED); // resetting paint color
        g.fillRect(MID - 18, TOP + 32, 36, 8); // scarf main band
        g.fillRect(MID + 5, TOP + 38, 10, 20);  // scarf tail
        g.fillPolygon(new int[]{20, 70, 120}, new int[]{130, 80, 130}, 3); // cabin roof
        g.setColor(new Color(139, 69, 19)); // resetting paint color
        g.fillRect(35, 130, 70, 50); // cabin wall
        g.drawLine(MID - 25, TOP + 50, MID - 55, TOP + 30); // left arm
        g.drawLine(MID + 25, TOP + 50, MID + 55, TOP + 35); // right arm
        g.setColor(Color.ORANGE); // resetting paint color
        g.fillPolygon(new int[]{MID, MID, MID + 25}, new int[]{TOP + 15, TOP + 23, TOP + 19}, 3); // carrot nose
        g.setColor(Color.BLACK); // resetting paint color
        g.fillOval(MID - 8, TOP + 10, 4, 4); // left eye
        g.fillOval(MID + 4, TOP + 10, 4, 4); // right eye
        g.drawArc(MID - 8, TOP + 18, 16, 8, 190, 160); // smile
        g.drawLine(MID - 22, TOP + 2, MID + 22, TOP + 2); // brim of hat
        g.fillRect(MID - 14, TOP - 22, 28, 24);          // top of hat
        g.fillRect(60, 150, 20, 30); // cabin door
    }

    /**
     * @param args the command line arguments
     */
    public static void main(String[] args) {
        // create a new JFrame object, initialize
        JFrame frame = new JFrame("Display Graphics");
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setSize(400, 300);

        // Create a new identifier for a DisplayGraph called "panel",
        // then create a new DisplayGraph object for it to refer to.
        DisplayGraph panel = new DisplayGraph();

        // Make the panel object the content pane of the JFrame.
        // This puts it into the drawable area of frame, and now
        // we do all our drawing to panel, using paintComponent(), above.
        frame.setContentPane(panel);
        frame.setVisible(true);
    }
}
