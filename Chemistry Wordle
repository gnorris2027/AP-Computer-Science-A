package com.mycompany.ap_cs_a_semester_1_final_project;

import java.util.ArrayList;
import java.util.Random;
import java.util.Scanner;

/**
 * 
 * @author gnorris2027
 */
public class AP_CS_A_Semester_1_Final_Project {

    public static void main(String[] args) {
// Array of six-letter chemistry related terms used as the possible secret words
        String[] wordBank = {
            "BARIUM", "CESIUM", "COBALT", "COPPER", "CURIUM", "ERBIUM",
            "HELIUM", "IODINE", "NICKEL", "RADIUM", "SILVER", "SODIUM",
            "SULFUR", "BEAKER", "ANIONS", "CATION", "ATOMIC", "BINARY",
            "BONDED", "BUFFER", "CARBON", "CHARGE", "DILUTE", "DIPOLE",
            "ENERGY", "ENZYME", "FUSION", "ISOMER", "LIQUID", "MATTER",
            "METALS", "METRIC", "PROTON", "OXIDES", "OXYGEN", "PHENOL",
            "PHOTON", "PLASMA", "SALINE", "SOLIDS", "SOLUTE", "ABSORB",
            "FILTER", "IGNITE", "IONIZE", "REDUCE", "REFLUX"
        };

// Initializes random, scanner, and inputChecker objects once 
        Random random = new Random();
        Scanner scanner = new Scanner(System.in);
        InputChecker checker = new InputChecker();
        String playAgain;

// Do-while loop that allows the player to play multiple rounds without restarting
        do {
// Select a random target word from the word bank
            String targetWord = wordBank[random.nextInt(wordBank.length)];
            int maxAttempts = 6;
            boolean hasWon = false;

// Display the game title, objective, and symbol key so that the user knows how to play
            System.out.println("\nChemistry Wordle");
            System.out.println("You have " + maxAttempts + " tries to guess a 6-letter chemistry related word.");
            System.out.println("[A] = Correct letter in the right spot");
            System.out.println("(A) = Correct letter in the wrong spot");
            System.out.println("A = Not in the word");
            System.out.println();

// Create a fresh board object to store and display guesses for the current round
            WordleBoard board = new WordleBoard();

            int attempts = 0;

// While loop runs until the player guesses the word or runs out of 6 tries
            while (attempts < maxAttempts && !hasWon) {
                System.out.print("\nGuess " + (attempts + 1) + " of " + maxAttempts + ": ");
                
// Reads input, removes any spaces, and converts to uppercase for checking
                String guess = scanner.nextLine().replace(" ", "").toUpperCase();
                if (!checker.isValid(guess)) {
                    continue;
                }

// Evaluates the guess against the target word, saves the formatted row, and prints the board
                String resultRow = board.checkGuess(guess, targetWord);
                board.addRow(resultRow);
                attempts++;

                board.printBoard();

// Checks if the player guessed the exact correct target word
                if (guess.equals(targetWord)) {
                    hasWon = true;
                    System.out.println("\nYou got it! The word was " + targetWord + ".");
                }
            }

// Reveals secret word if all attempts were used without winning
            if (!hasWon) {
                System.out.println("\nYou ran out of tries. The word was " + targetWord + ".");
            }

// Input validation loop that is used to ensure the player enters only 'Y' or 'N' to replay the game
            while (true) {
                System.out.print("\nDo you want to play again? (Y/N): ");
                playAgain = scanner.nextLine().replace(" ", "").toUpperCase();
                if (playAgain.equals("Y") || playAgain.equals("N")) {
                    break;
                }
                System.out.println("Please enter Y or N.");
            }

        } while (playAgain.equals("Y"));
        System.out.println("\nThanks for playing!");
        scanner.close();
    }
}

class InputChecker {
// Checks that the guess is exactly 6 characters long and contains only A-Z letters.
    public boolean isValid(String guess) {
        if (guess.length() != 6) {
            System.out.println("Must be 6 letters!");
            return false;
        }

// Loops through every character to verify no numbers or symbols were entered by the player
        for (int i = 0; i < guess.length(); i++) {
            char ch = guess.charAt(i);
            if (ch < 'A' || ch > 'Z') {
                System.out.println("Letters only, no numbers or spaces!");
                return false;
            }
        }

        return true;
    }
}

class WordleBoard {

// Stores each formatted guess row in order
    private ArrayList<String> rows;

// Constructor that initializes an empty ArrayList for the game board.
    public WordleBoard() {
        rows = new ArrayList<String>();
    }

// Adds a newly formatted guess result row to the board history.
    public void addRow(String row) {
        rows.add(row);
    }

// Compares each letter of the player's guess to the target word and formats each letter using [ ], ( ), or plain spacing
    public String checkGuess(String guess, String targetWord) {
        String line = "";

// Inspects each of the 6 letter positions
        for (int i = 0; i < 6; i++) {
            char c = guess.charAt(i);

            if (c == targetWord.charAt(i)) {
                line += "[" + c + "] ";
            } else if (targetWord.indexOf(c) != -1) {
// Letter exists somewhere in the target word, but at a different space
                line += "(" + c + ") ";
            } else {
// Letter does not appear anywhere in the secret word
                line += " " + c + "  "; 
            }
        }

        return line;
    }

// Prints all stored guess rows from the ArrayList to display the current board
    public void printBoard() {
        System.out.println();
        for (int i = 0; i < rows.size(); i++) {
            System.out.println(rows.get(i));
        }
    }
}
