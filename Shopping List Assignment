import java.util.ArrayList;
import java.util.Scanner;

// Custom Class holding BOTH name and price together
class ShoppingListItem {
    private String name;
    private double price;

    public ShoppingListItem(String name, double price) {
        this.name = name;
        this.price = price;
    }

    public String getName() {
        return name;
    }

    public double getPrice() {
        return price;
    }

    public String toString() {
        return name + " - $" + price;
    }
}

public class ShoppingList {
    public static void main(String[] args) {
        Scanner scan = new Scanner(System.in);
        
        // Single ArrayList holding objects that contain both item names and prices
        ArrayList<ShoppingListItem> itemList = new ArrayList<ShoppingListItem>();
        ArrayList<Integer> quantitiesList = new ArrayList<Integer>();

        System.out.println("Enter your shopping list items.");
        System.out.println("Type 'done' for item name when finished.\n");

        System.out.print("Enter item name: ");
        String itemName = scan.nextLine();

        // Controlled loop check (no while(true) or break)
        while (!itemName.equalsIgnoreCase("done")) {

            System.out.print("Enter price for " + itemName + ": ");
            double itemPrice = Double.parseDouble(scan.nextLine());

            System.out.print("How many " + itemName + " purchased? ");
            int numPurchased = Integer.parseInt(scan.nextLine());

            // Instantiate object with name & price, then store in ArrayList
            ShoppingListItem newItem = new ShoppingListItem(itemName, itemPrice);
            itemList.add(newItem);
            quantitiesList.add(numPurchased);
            
            System.out.println();

            // Next item prompt at bottom of loop
            System.out.print("Enter item name (or 'done' to stop): ");
            itemName = scan.nextLine();
        }

        // Display items with prices and total
        printReceipt(itemList, quantitiesList);

        // Remove item by number
        if (itemList.size() > 0) {
            System.out.print("\nEnter the number of the item you want to remove (or 0 to skip): ");
            int removeNum = Integer.parseInt(scan.nextLine());

            if (removeNum > 0 && removeNum <= itemList.size()) {
                int index = removeNum - 1;
                
                // Uses ArrayList remove method
                ShoppingListItem removedItem = itemList.remove(index);
                quantitiesList.remove(index);
                
                System.out.println("Removed " + removedItem.getName() + " from your list.");
            }
        }

        // Redisplay updated list and dynamic total
        System.out.println("\n--- Updated Shopping List ---");
        printReceipt(itemList, quantitiesList);

        scan.close();
    }

    // Helper method matching class while-loop demo style
    public static void printReceipt(ArrayList<ShoppingListItem> items, ArrayList<Integer> quantities) {
        if (items.size() == 0) {
            System.out.println("No items in list.");
            return;
        }

        System.out.println("Items Purchased:");
        double totalCost = 0.0;
        int i = 0;

        while (i < items.size()) {
            // Retrieve the item object to access both name and price
            ShoppingListItem item = items.get(i);
            int qty = quantities.get(i);
            
            double subtotal = item.getPrice() * qty;
            totalCost += subtotal;

            System.out.println((i + 1) + ". " + item.getName() 
                + " - Price: $" + item.getPrice() 
                + " | Qty: " + qty 
                + " | Subtotal: $" + subtotal);
            i++;
        }

        System.out.println("Total Cost: $" + totalCost);
    }
}
